# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://sazvida.com

# Endpoint that receives the "Book a pilot" form as a JSON POST.
# Works with Formspree (https://formspree.io/f/xxxx), Web3Forms, Getform, or your own API.
# Leave empty to disable submissions (the form will show a "not configured" notice).
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: access key some form services need in the body (e.g. Web3Forms).
NEXT_PUBLIC_FORM_ACCESS_KEY=
